# תבנית משתני הסביבה של האתר. הערכים האמיתיים יושבים ב-.env.local (פיתוח)
# וב-/etc/sea-tower/sea-tower.env (ייצור). אין לשמור ערכים אמיתיים בקובץ הזה.

# --- Supabase (לידים) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role — שרת בלבד; לעולם לא NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# --- GuestHub (מנוע ההזמנות) ---
GUESTHUB_API_URL=
# סוד שרת-לשרת; לעולם לא NEXT_PUBLIC
GUESTHUB_BOOKING_SECRET=

# --- מדידה ---
# מכל Google Tag Manager, בפורמט GTM-XXXXXXX. כל עוד הוא ריק, לא נטען שום
# סקריפט מדידה ולא נוצר dataLayer (ראו src/lib/analytics.ts).
# GA4 / Google Ads / Meta Pixel מוגדרים בתוך המכל — לא כמשתנים נפרדים כאן,
# כדי שלא ייטענו שני מקורות מדידה במקביל.
NEXT_PUBLIC_GTM_ID=

# אימות בעלות ל-Google Search Console (תג meta). שרת בלבד — לא NEXT_PUBLIC.
GOOGLE_SITE_VERIFICATION=
# אימות בעלות ל-Bing Webmaster Tools (תג meta).
BING_SITE_VERIFICATION=

# --- התראות מייל על לידים (src/lib/mailer.ts) ---
# שרת ה-SMTP. בייצור: ה-SMTP Relay של Google Workspace, שמאשר את כתובות ה-IP
# של השרת (IPv4 ו-IPv6) בלי סיסמה — smtp-relay.gmail.com / 587 / false.
SMTP_HOST=
# ריק = 587
SMTP_PORT=
# true = TLS מלא (465). false = STARTTLS חובה (587). ריק = false.
SMTP_SECURE=
# כתובת השולח (from). חייבת להיות כתובת מהדומיין המאושר ב-relay.
GMAIL_USER=
# אופציונלי: סיסמת אפליקציה של Google. כשמוגדרת — התחברות עם אימות (למשל
# smtp.gmail.com / 465 / true). כשריקה — בלי אימות (relay). שרת בלבד.
GMAIL_APP_PASSWORD=
