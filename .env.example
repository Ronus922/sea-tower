# תבנית משתני הסביבה של האתר. הערכים האמיתיים יושבים ב-.env.local (פיתוח)
# וב-/etc/sea-tower/sea-tower.env (ייצור). אין לשמור ערכים אמיתיים בקובץ הזה.

# --- Supabase (לידים) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role — שרת בלבד; לעולם לא NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# --- GuestHub (מנוע ההזמנות) ---
GUESTHUB_API_URL=
# סוד שרת-לשרת; לעולם לא NEXT_PUBLIC
GUESTHUB_BOOKING_SECRET=

# --- מדידה ---
# מכל Google Tag Manager, בפורמט GTM-XXXXXXX. כל עוד הוא ריק, לא נטען שום
# סקריפט מדידה ולא נוצר dataLayer (ראו src/lib/analytics.ts).
# GA4 / Google Ads / Meta Pixel מוגדרים בתוך המכל — לא כמשתנים נפרדים כאן,
# כדי שלא ייטענו שני מקורות מדידה במקביל.
NEXT_PUBLIC_GTM_ID=

# אימות בעלות ל-Google Search Console (תג meta). שרת בלבד — לא NEXT_PUBLIC.
GOOGLE_SITE_VERIFICATION=
# אימות בעלות ל-Bing Webmaster Tools (תג meta).
BING_SITE_VERIFICATION=
